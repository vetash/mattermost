FROM mattermost/mattermost-team-edition:11.10.0

USER root

COPY --chown=2000:2000 .docker/mm/mattermost/bin /mattermost/bin
COPY --chown=2000:2000 .docker/mm/mattermost/client /mattermost/client
COPY --chown=2000:2000 .docker/mm/mattermost/i18n /mattermost/i18n
COPY --chown=2000:2000 .docker/mm/mattermost/fonts /mattermost/fonts
COPY --chown=2000:2000 .docker/mm/mattermost/templates /mattermost/templates

USER mattermost
